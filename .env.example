APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DISPLAY_TIMEZONE=America/Toronto

PHP_PATH=/usr/local/bin/php

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Remote VieFUND SQL Server connection
VIEFUND_DB_HOST=127.0.0.1
VIEFUND_DB_PORT=1433
VIEFUND_DB_DATABASE=
VIEFUND_DB_USERNAME=
VIEFUND_DB_PASSWORD=
VIEFUND_DB_CHARSET=utf8
VIEFUND_DB_ENCRYPT=yes
VIEFUND_DB_TRUST_SERVER_CERTIFICATE=false
VIEFUND_DB_SCHEMA=dbo

# Default status filters for the daily-totals sync (scheduled command) and reports.
# Fund: comma-separated status IDs 0=Deleted 1=Rejected 2=Cancelled 3=Pending 4=Accepted 5=Contracted 6=Confirmed
# Trust: comma-separated names (Deleted|Unsettled|Settled) or positions 0|1|2; empty excludes trust.
VIEFUND_DEFAULT_FUND_STATUS=6
VIEFUND_DEFAULT_TRUST_STATUS=Settled
# Hide $0.00 transactions globally (they affect counts, never net totals). Default false = include them.
VIEFUND_HIDE_ZERO_AMOUNT=false
# Snapshot-backed reports fall back to the live VieFund cash ledger when the
# nightly rolling run or weekly full-history verification is older than these limits.
VIEFUND_CASH_SNAPSHOT_RECENT_RUN_HOURS=36
VIEFUND_CASH_SNAPSHOT_FULL_VERIFICATION_DAYS=8
# Streaming controls for the All Transactions Excel workbook only.
# Other Excel exports continue to use the existing Laravel Excel implementation.
VIEFUND_ALL_TRANSACTIONS_EXPORT_ROWS_PER_SHEET=1000000
VIEFUND_ALL_TRANSACTIONS_EXPORT_SPLIT_TARGET_ROWS=65000
VIEFUND_ALL_TRANSACTIONS_EXPORT_BATCH_SIZE=5000
# All Transactions columns shown in the table and Excel transaction sheets.
# Remove keys you do not want; their order controls table and export order.
# An empty value shows all columns in the default order.
# matched_to_bank       = Match
# cash_transaction_id   = Cash Txn ID
# fund_transaction_id   = Fund Txn ID
# trust_transaction_id  = Trust Txn ID
# ledger_relationship   = Relationship
# source_id             = Source ID
# customer_name         = Customer Name
# plan_account_id       = Plan Account ID
# transaction_type      = Txn Type
# status                = Cash Status
# trust_status          = Trust Status
# notes                 = Notes
# created_date          = Created Date
# trade_date            = Trade Date
# processing_date       = Processing Date
# settlement_date       = Settlement Date
# currency_code         = Currency
# amount                = Amount
VIEFUND_ALL_TRANSACTIONS_VISIBLE_COLUMNS=matched_to_bank,cash_transaction_id,fund_transaction_id,trust_transaction_id,ledger_relationship,source_id,customer_name,plan_account_id,transaction_type,status,trust_status,notes,created_date,trade_date,processing_date,settlement_date,currency_code,amount

# Linked EFT columns. Remove unwanted keys and reorder the rest as desired.
# file_name       = EFT File
# id              = EFT Item ID
# sequence_number = EFT Sequence
# created_at      = EFT Created
# effective_date  = EFT Effective
# trade_date      = EFT Trade
# settlement_date = EFT Settlement
# type            = EFT Type
# status_id       = EFT Status
# holder_name     = EFT Holder
# holder_id       = EFT Holder ID
# source          = EFT Source
# amount          = EFT Amount
# file_total      = EFT File Total
# notes           = EFT Notes
VIEFUND_ALL_TRANSACTIONS_EFT_VISIBLE_COLUMNS=file_name,id,sequence_number,created_at,effective_date,trade_date,settlement_date,type,status_id,holder_name,holder_id,source,amount,file_total,notes

# Linked bank columns. Remove unwanted keys and reorder the rest as desired.
# id                      = Bank Txn ID
# value_date              = Bank Value Date
# direction               = Bank Direction
# amount                  = Bank Txn Amount
# transaction_total       = Bank Txn Total
# currency                = Bank Currency
# account_number          = Bank Account
# settlement_number       = Bank Settlement #
# memo_type               = Bank Memo Type
# counterparty            = Bank Counterparty
# wire_reference          = Bank Wire Ref
# description             = Bank Description
# source_file             = Bank Source File
# reconciliation_variance = Bank Txn Variance (bank net minus EFT/FSP net)
# reconciliation_note     = Variance Note
VIEFUND_ALL_TRANSACTIONS_BANK_VISIBLE_COLUMNS=id,value_date,direction,amount,transaction_total,currency,account_number,settlement_number,memo_type,counterparty,wire_reference,description,source_file,reconciliation_variance,reconciliation_note

# Linked FSP columns. Remove unwanted keys and reorder the rest as desired.
# fsp_source              = FSP Source
# source_file             = FSP File
# items_total             = FSP Items Net
# id                      = FSP Record ID
# record_index            = FSP Record #
# create_date             = FSP Created
# trade_date              = FSP Trade
# settlement_date         = FSP Settlement
# side                    = FSP Side
# transaction_type        = FSP Txn Type
# order_id                = FSP Order ID
# source_id               = FSP Source ID
# management_code         = FSP Management Code
# dealer_code             = FSP Dealer Code
# dealer_account_id       = FSP Dealer Account
# rep_code                = FSP Rep Code
# intermediary_code       = FSP Intermediary Code
# intermediary_account_id = FSP Intermediary Account
# account_type            = FSP Account Type
# fund_account_id         = FSP Fund Account
# fund_id                 = FSP Fund ID
# currency                = FSP Currency
# gross_amount            = FSP Gross
# net_amount              = FSP Net
# settlement_amount       = FSP Settlement Amount
# fsp_note                = FSP Note
VIEFUND_ALL_TRANSACTIONS_FSP_VISIBLE_COLUMNS=fsp_source,source_file,items_total,id,record_index,create_date,trade_date,settlement_date,side,transaction_type,order_id,source_id,management_code,dealer_code,dealer_account_id,rep_code,intermediary_code,intermediary_account_id,account_type,fund_account_id,fund_id,currency,gross_amount,net_amount,settlement_amount,fsp_note
VIEFUND_ALL_TRANSACTIONS_LINK_CACHE_TTL_MINUTES=240
VIEFUND_ALL_TRANSACTIONS_LINK_CACHE_RETENTION_DAYS=7
VIEFUND_ALL_TRANSACTIONS_LINK_CACHE_REMOTE_BATCH_SIZE=20000
VIEFUND_ALL_TRANSACTIONS_LINK_CACHE_WRITE_BATCH_SIZE=1000
VIEFUND_ALL_TRANSACTIONS_LINK_CACHE_QUERY_BATCH_SIZE=5000
VIEFUND_ALL_TRANSACTIONS_WORKING_SET_TTL_MINUTES=1440
VIEFUND_ALL_TRANSACTIONS_WORKING_SET_BATCH_SIZE=1000
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=150
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
