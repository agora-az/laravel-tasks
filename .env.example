APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

PHP_PATH=/usr/local/bin/php

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Remote VieFUND SQL Server connection
VIEFUND_DB_HOST=127.0.0.1
VIEFUND_DB_PORT=1433
VIEFUND_DB_DATABASE=
VIEFUND_DB_USERNAME=
VIEFUND_DB_PASSWORD=
VIEFUND_DB_CHARSET=utf8
VIEFUND_DB_ENCRYPT=yes
VIEFUND_DB_TRUST_SERVER_CERTIFICATE=false
VIEFUND_DB_SCHEMA=dbo

# Default status filters for the daily-totals sync (scheduled command) and reports.
# Fund: comma-separated status IDs 0=Deleted 1=Rejected 2=Cancelled 3=Pending 4=Accepted 5=Contracted 6=Confirmed
# Trust: comma-separated names (Deleted|Unsettled|Settled) or positions 0|1|2; empty excludes trust.
VIEFUND_DEFAULT_FUND_STATUS=6
VIEFUND_DEFAULT_TRUST_STATUS=Settled
# Hide $0.00 transactions globally (they affect counts, never net totals). Default false = include them.
VIEFUND_HIDE_ZERO_AMOUNT=false

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
