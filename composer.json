{
    "name": "opus/reconciliation",
    "description": "Laravel web project for generating reconciliation reports",
    "type": "project",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^12.0",
        "smalot/pdfparser": "^2.12",
        "phpseclib/phpseclib": "^3.0.57",
        "maatwebsite/excel": "^4.0",
        "openspout/openspout": "^4.32"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "authors": [
        {
            "name": "staceyrattlesnake",
            "email": "staceyrattlesnake@onenationgov.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "laravel/tinker": "^3.0"
    }
}
